Authorization: Bearer {{token_user}}

{
  "nombre": "Mouse Gamer",
  "descripcion": "Mouse óptico 16000 DPI",
  "precio": 35.00,
  "stock": 10,
  "categoria": {
    "id": 1
  }
}

